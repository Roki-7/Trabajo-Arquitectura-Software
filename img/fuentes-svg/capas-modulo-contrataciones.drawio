        <mxCell id="appbody" value="«casos de uso»&#10;AceptarPropuesta&#10;ConfirmarContratacion&#10;ProponerCambioDeCondiciones&#10;&#10;«entradas y resultados»&#10;Datos de la operación y sus resultados&#10;&#10;«puertos de salida»&#10;RepositorioContrataciones&#10;UnidadDeTrabajo · AvisosPendientes&#10;ConsultaPropuestas · GestionSolicitudes&#10;&#10;Coordina permisos, reglas y guardado." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9EDF2;strokeColor=#56616F;fontColor=#232C38;fontFamily=Arial;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.3;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
