        <mxCell id="rules-title" value="REGLAS DEL MONOLITO MODULAR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#17324D;strokeColor=#17324D;fontColor=#173456;fontFamily=Arial;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.3;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
