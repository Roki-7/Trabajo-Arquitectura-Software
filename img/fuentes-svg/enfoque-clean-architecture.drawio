        <mxCell id="rules" value="REGLAS DE DEPENDENCIA Y ALCANCE" style="rounded=0;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C7D1DC;fontColor=#26364A;fontFamily=Arial;fontSize=21;fontStyle=1;align=center;verticalAlign=top;spacing=12;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
